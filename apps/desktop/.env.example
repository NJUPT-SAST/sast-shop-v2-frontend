# 开发、mock、local 默认关闭鉴权；连接真实 remote 后端时将两项都改为 required。
AUTH_MODE=off
SESSION_COOKIE_SECRET=
NEXT_PUBLIC_FEISHU_APP_ID=

NEXT_PUBLIC_DATA_SOURCE=mock
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3002
NEXT_PUBLIC_FEEDBACK_FORM_URL=

# 当前 local/fauxrpc facade 仍读取 NEXT_PUBLIC_CONNECT_BASE_URL；服务端代理优先读取 CONNECT_BASE_URL。
NEXT_PUBLIC_CONNECT_BASE_URL=http://127.0.0.1:6660
CONNECT_BASE_URL=http://127.0.0.1:6660
# 生产就绪探针使用后端提供的独立 HTTPS 健康检查地址，不能指向 /api/connect。
CONNECT_HEALTH_URL=https://api.example.com/health/ready
