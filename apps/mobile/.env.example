# 仅本地 mock/local 开发可关闭登录和登录时的飞书环境校验；生产环境强制 required。
AUTH_MODE=off
SESSION_COOKIE_SECRET=
NEXT_PUBLIC_FEISHU_APP_ID=
# 仅用于本地视觉验收；开启后展示飞书移动端入口，但不会伪造 JSAPI。
NEXT_PUBLIC_FORCE_FEISHU_UI=false

NEXT_PUBLIC_DATA_SOURCE=local
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3001
NEXT_PUBLIC_FEEDBACK_FORM_URL=

# 当前 local/fauxrpc facade 仍读取 NEXT_PUBLIC_CONNECT_BASE_URL；Next 代理优先读取服务端 CONNECT_BASE_URL。
NEXT_PUBLIC_CONNECT_BASE_URL=http://127.0.0.1:6660
CONNECT_BASE_URL=http://127.0.0.1:6660
# 生产就绪探针使用后端提供的独立 HTTPS 健康检查地址，不能指向 /api/connect。
CONNECT_HEALTH_URL=https://api.example.com/health/ready
