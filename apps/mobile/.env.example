# 开发、mock、local 默认关闭鉴权；连接真实 remote 后端时将两项都改为 required。
NEXT_PUBLIC_AUTH_MODE=off
AUTH_MODE=off

NEXT_PUBLIC_DATA_SOURCE=local
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3001

# 当前 local/fauxrpc facade 仍读取 NEXT_PUBLIC_CONNECT_BASE_URL；Next 代理优先读取服务端 CONNECT_BASE_URL。
NEXT_PUBLIC_CONNECT_BASE_URL=http://127.0.0.1:6660
CONNECT_BASE_URL=http://127.0.0.1:6660
