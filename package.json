{
  "name": "sast-shop-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.1",
  "scripts": {
    "dev:mobile": "pnpm --filter @sast-shop/mobile dev",
    "dev:desktop": "pnpm --filter @sast-shop/desktop dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test && vitest run config/auth-recovery.test.ts config/connect-health-url.test.ts config/feedback-deployment.test.ts config/next-security.test.ts config/product-image-upload.test.ts",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "audit:prod": "pnpm audit --prod --audit-level high",
    "proto:generate": "buf generate --template buf.gen.yaml",
    "mock:schema": "node -e \"require('node:fs').mkdirSync('.mock/fauxrpc', { recursive: true })\" && buf build buf.build/sast/sast-shop-v2 -o .mock/fauxrpc/sast-shop-v2.binpb",
    "mock:fauxrpc": "pnpm mock:schema && fauxrpc run --schema=.mock/fauxrpc/sast-shop-v2.binpb --stubs=mock/fauxrpc/stubs --addr 127.0.0.1:6660 --dashboard",
    "mock:generate:user": "pnpm mock:schema && fauxrpc generate --schema=.mock/fauxrpc/sast-shop-v2.binpb --target=sast.sastshopv2.user.v1.UserInfo --stubs=mock/fauxrpc/stubs --seed=1"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.71.0",
    "@bufbuild/protoc-gen-es": "^2.12.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.7",
    "prettier": "^3.9.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
