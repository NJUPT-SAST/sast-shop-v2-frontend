{
  "name": "sast-shop-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:mobile": "pnpm --filter @sast-shop/mobile dev",
    "dev:desktop": "pnpm --filter @sast-shop/desktop dev",
    "build": "next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "mock:schema": "mkdir -p .mock/fauxrpc && buf build buf.build/sast/sast-shop-v2 -o .mock/fauxrpc/sast-shop-v2.binpb",
    "mock:fauxrpc": "pnpm mock:schema && fauxrpc run --schema=.mock/fauxrpc/sast-shop-v2.binpb --stubs=mock/fauxrpc/stubs --addr 127.0.0.1:6660 --dashboard",
    "mock:generate:user": "pnpm mock:schema && fauxrpc generate --schema=.mock/fauxrpc/sast-shop-v2.binpb --target=sast.sastshopv2.user.v1.UserInfo --stubs=mock/fauxrpc/stubs --seed=1"
  },
  "dependencies": {
    "next": "16.2.7",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "prettier": "^3.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
